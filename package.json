{
  "name": "exam-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "generate:seed": "tsx scripts/generate-seed.ts",
    "generate:formal-csv": "tsx scripts/generate-formal-csv.ts",
    "generate:reviewed-dataset": "tsx scripts/generate-reviewed-dataset.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@next/swc-wasm-nodejs": "^15.5.20",
    "@supabase/supabase-js": "^2.110.7",
    "lucide-react": "^0.468.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
